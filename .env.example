# Application Configuration
APP_NAME=AccessTokenDropbox
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# API Authentication
# For simple mode: use a single secret key
API_SECRET_KEY=your-super-secret-key-here
AUTH_MODE=simple

# For HMAC mode: use comma-separated list of allowed signatures
# AUTH_MODE=hmac
# ALLOWED_SIGNATURES=signature1,signature2,signature3

# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
SECRET_NAME=dropbox-access-token
# Optional: Path to service account credentials JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Dropbox Configuration
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret

# Server Configuration
HOST=0.0.0.0
PORT=8080
